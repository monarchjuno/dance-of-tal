{
  "name": "dance-of-tal-mcp",
  "version": "0.5.2",
  "description": "MCP server and CLI for Tal x Dance persona composition",
  "license": "MIT",
  "author": "monarchjuno",
  "repository": {
    "type": "git",
    "url": "https://github.com/monarchjuno/dance-of-tal.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/monarchjuno/dance-of-tal/tree/main/mcp",
  "bugs": {
    "url": "https://github.com/monarchjuno/dance-of-tal/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "persona",
    "prompt-engineering",
    "openclaw"
  ],
  "type": "module",
  "bin": {
    "dot": "dist/cli/dot.js",
    "tal": "dist/cli/tal.js",
    "dance": "dist/cli/dance.js"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "tsup src/server/index.ts src/cli/tal.ts src/cli/dance.ts src/cli/dot.ts --format esm --out-dir dist",
    "postinstall": "npm run build",
    "start": "node dist/server/index.js",
    "cli": "tsx src/cli/tal.ts",
    "cli:dance": "tsx src/cli/dance.ts",
    "cli:dot": "tsx src/cli/dot.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.17.5",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  }
}
